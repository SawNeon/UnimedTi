# Copie para .env e preencha. O .env NAO vai para o git (ver .gitignore) e no
# servidor fica com permissao 600.
#
#   cp .env.example .env && chmod 600 .env

# Porta pela qual a rede abre o sistema: http://172.20.8.13:8090
# A 80 e a 443 ja sao do uniquiz, e a 8080 do uniquiz em dev.
PORTA_PUBLICA=8090

# Banco. Estas tres variaveis sao usadas duas vezes: o container do MySQL cria
# o usuario com elas na primeira subida, e a aplicacao conecta com elas.
# Gere senhas longas e aleatorias -- elas nunca sao digitadas por ninguem.
DB_USERNAME=systemti
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Assina o token de quem esta logado. E a variavel mais importante do arquivo:
# com um valor previsivel, qualquer um forja um token de administrador.
# Trocar o segredo derruba quem estiver logado -- so isso.
JWT_SECRET=

# Os enderecos pelos quais o sistema e aberto no navegador, separados por
# virgula. Precisa bater com o que aparece na barra do navegador.
CORS_ALLOWED_ORIGINS=http://172.20.8.13:8090,http://kratos:8090

# Primeiro acesso. Valem UMA vez, com o banco vazio: criam o administrador que
# cadastra todo mundo depois. Com um usuario ja no banco, sao ignoradas -- nao
# servem para repor senha de ninguem.
ADMIN_LOGIN=admin
ADMIN_SENHA=
ADMIN_NOME=Administrador
ADMIN_EMAIL=

# Recuperacao de senha por e-mail. Em branco, o sistema sobe e o resto
# funciona; so o "esqueci minha senha" fica fora do ar.
MAIL_USERNAME=
MAIL_PASSWORD=
